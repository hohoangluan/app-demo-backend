# Copy this file to .env for local development. Never commit .env.

# Application
APP_ENV=local
HTTP_PORT=8000
LOG_LEVEL=debug

# PostgreSQL (local Docker Compose only)
POSTGRES_DB=app_demo
POSTGRES_USER=app_demo
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://app_demo:replace-with-a-local-database-password@postgres:5432/app_demo

# Authentication and field encryption
# Store only hashes/derived values here, never the raw bearer tokens.
# *_TOKEN_HASH must be exactly 64 lowercase hex characters: the hex encoding
# of a 32-byte HMAC-SHA256(raw token, domain-separated message) digest, per
# docs/p1-api-plan.md "Bearer authentication" -> "Provisioning format".
PUBLIC_API_TOKEN_HASH=replace-with-derived-public-token-hash-64-hex-chars
# Non-empty identifier for the single prototype Public API client.
PUBLIC_API_CLIENT_ID=replace-with-a-public-client-id
# Comma-separated Public API scopes granted to that client. Known scopes:
# service:execute (POST /api/v1/service/*), requests:read (GET status).
PUBLIC_API_SCOPES=service:execute,requests:read
DEVICE_API_TOKEN_HASH=replace-with-derived-device-token-hash-64-hex-chars
FIELD_ENCRYPTION_KEY=replace-with-a-urlsafe-base64-encoded-32-byte-key

# Delivery (fake is the safe default for the prototype)
DELIVERY_TRANSPORT=fake
# Point to a service-account file outside the repository only when using FCM.
# FCM_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/path/outside/repository/service-account.json

# Workers
WORKER_POLL_SECONDS=0.5
WORKER_BATCH_SIZE=20
DELIVERY_LEASE_SECONDS=30
CALLBACK_LEASE_SECONDS=30

# Callback is disabled while these variables are unset. Configure all three
# together when enabling it.
# CALLBACK_URL=https://callback.example.test/requests
# CALLBACK_TOKEN=replace-with-callback-bearer-token
# CALLBACK_ALLOWED_HOSTS=callback.example.test

# Demo-only time scaling; keep 1 for real elapsed time.
DEMO_TIME_SCALE=1
