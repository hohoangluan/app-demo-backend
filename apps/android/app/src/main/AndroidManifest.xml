<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Phone & Contacts ─────────────────────────────────────────── -->
    <!-- emergency_call, contact_call: dial/call phone number -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- T19: observe ringing state/caller and accept or reject from glasses. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- emergency_call: send location SMS to the configured emergency contact -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- CALL_PHONE/SEND_SMS otherwise imply required telephony hardware (blocks ChromeOS/tablet installs) -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- ── Audio ────────────────────────────────────────────────────── -->
    <!-- music_volume: adjust media stream volume -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- ── Location ─────────────────────────────────────────────────── -->
    <!-- navigation_start: pass current location to Google Maps -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- emergency_call runs from a background FCM push, not the foreground app;
         without this, LocationManager silently returns no last-known fix there -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ── Overlay / Display ────────────────────────────────────────── -->
    <!-- display_show: render overlay notifications on top of other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ── Network & Foreground Service ─────────────────────────────── -->
    <!-- DeviceApiClient: HTTP calls to backend /register and /report -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- CommandExecutionService runs one pushed command to completion; Android 14+
         requires the type-specific permission alongside the generic one -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Keeps high-priority FCM data messages from being delayed by Doze while screen is off -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Lets CommandLaunchActivity present itself over the lock screen from a background push -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
        Android 11+ package visibility: without these, PackageManager.resolveActivity()
        for Maps/YouTube Music/Grab returns null even when the app is installed, so
        music_play, navigation_start and ride_quote/confirm would silently fall back
        instead of opening the real app.
    -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.spotify.music" />
        <!--
            music_play's fallback when Spotify takes the search but never produces
            audio (a Free account cannot start an arbitrary track on demand).
            Without this entry getPackageInfo() throws NameNotFoundException and
            binding MusicBrowserService fails, so the fallback would silently never
            run - exactly the trap the comment above describes, for the one app it
            names but never listed.
        -->
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.grabtaxi.passenger" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".YourEyesApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppDemo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Transient trampoline shown by the full-screen-intent notification so a
            background command can open its real target screen even over a locked
            screen. No UI of its own — see NotificationLauncher.kt.
        -->
        <activity
            android:name=".launch.CommandLaunchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
            FCM Receiver — receives push commands from backend via Firebase.
        -->
        <service
            android:name=".fcm.FcmPushReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".telephony.PhoneStateBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!--
            Executes one pushed command. Handlers wait for the handset to confirm
            the action really happened, so execution outlives the FCM receiver's
            own grace period — see CommandExecutionService.kt.
        -->
        <service
            android:name=".service.CommandExecutionService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!--
            Empty listener whose only job is to make this app eligible for
            MediaSessionManager.getActiveSessions(), which is what lets
            music_play press play on YouTube Music's own session. The user has
            to enable it under Settings > Notifications.
        -->
        <service
            android:name=".service.MediaControlListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="appdemo_commands" />



    </application>
</manifest>
