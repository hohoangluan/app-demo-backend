<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Phone & Contacts ─────────────────────────────────────────── -->
    <!-- emergency_call, contact_call: dial/call phone number -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- ── Audio ────────────────────────────────────────────────────── -->
    <!-- music_volume: adjust media stream volume -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- ── Camera ───────────────────────────────────────────────────── -->
    <!-- camera_capture: open camera for photo/video -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- ── Location ─────────────────────────────────────────────────── -->
    <!-- navigation_start: pass current location to Google Maps -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ── Overlay / Display ────────────────────────────────────────── -->
    <!-- display_show: render overlay notifications on top of other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ── Network & Foreground Service ─────────────────────────────── -->
    <!-- DeviceApiClient: HTTP calls to backend /register and /report -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppDemo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            FCM Receiver — receives push commands from backend via Firebase.
            Replace com.google.firebase.messaging.DEFAULT_NOTIFICATION_CHANNEL_ID
            with your own channel ID once google-services.json is configured.
        -->
        <!--
        <service
            android:name=".fcm.FcmPushReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="appdemo_commands" />
        -->

    </application>
</manifest>
